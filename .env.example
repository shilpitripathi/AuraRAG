# =================================================================
# AuraRAG Environment Configuration
# Copy this file to .env and provide your actual API keys and values.
# =================================================================

# Groq API Key for LLM inference (Required)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model Identifier (Optional, defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# External MCP Server URL for Live Web Search (Optional, defaults to https://search.parallel.ai/mcp)
MCP_SERVER_URL=https://search.parallel.ai/mcp

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In production, set this to your deployed frontend domain, e.g. https://aurarag.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ChromaDB Vector Store Persistence Directory
CHROMA_PERSIST_DIR=chroma_db

# Maximum Document Upload Size in Megabytes (default: 20)
MAX_UPLOAD_SIZE_MB=20

# Deployment Environment: 'development' or 'production'
DEPLOYMENT_ENV=development

# Enable Local Filesystem Discovery (Downloads/Documents/Desktop)
# Set to 'false' in cloud deployment where backend has no access to user client filesystem
ENABLE_LOCAL_FILE_ACCESS=true
